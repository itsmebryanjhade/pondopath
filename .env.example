# SoloForge development environment. Keep real keys in .env.local only.
SOLOFORGE_ENVIRONMENT=development
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Trusted public origin used for owner-provided invitation links. HTTPS in production.
APP_URL=http://localhost:3000

# Server-only AI configuration. Only fictional demo workspaces are enabled.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_PROVIDER=openai

# Server-only automation scope. Use a random token of at least 32 characters.
# Never copy these into NEXT_PUBLIC variables or exported Node-RED flows.
AUTOMATION_TOKEN=
AUTOMATION_BUSINESS_ID=

# scripts/seed-demo.mjs writes fictional demo account details to .env.local.
# Never commit passwords or copy server credentials into public variables.

# Nonsecret robot email shown when sharing a Google Sheet as Viewer.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
